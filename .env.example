PORT=8877
HOST=127.0.0.1
FREEBUFF_API_KEY=change-this-local-key
FREEBUFF_DEBUG=false

# 免费模型通常需要美国出口。不使用代理时请留空。
HTTP_PROXY=http://127.0.0.1:3067
HTTPS_PROXY=http://127.0.0.1:3067
ALL_PROXY=http://127.0.0.1:3067
NO_PROXY=127.0.0.1,localhost
NODE_USE_ENV_PROXY=1

# 高级功能：为 credentials 中写有 proxy 字段的账号启用独立出口。
# 默认关闭；Windows 桌面助手可在“账号独立代理”窗口安全配置。
FREE_PROXY_ACCOUNTS=0

# 可选的本机管理 API。默认关闭，不提供 Web 面板。
# 只有同时设置随机令牌并保持 HOST=127.0.0.1 时才会启用。
FREEBUFF_MANAGEMENT_API=0
FREEBUFF_MANAGEMENT_TOKEN=

# 仅供 Docker Compose 使用。容器内的 127.0.0.1 不是宿主机。
DOCKER_PROXY=http://host.docker.internal:3067
